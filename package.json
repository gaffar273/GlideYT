{
  "name": "lan-tube",
  "version": "0.1.3",
  "private": true,
  "description": "A local Wi-Fi YouTube remote for Windows and Android",
  "workspaces": [
    "apps/android",
    "packages/core"
  ],
  "engines": {
    "node": ">=22.11.0"
  },
  "scripts": {
    "start": "node apps/companion/src/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node scripts/smoke-browser.mjs",
    "test:youtube": "node scripts/smoke-browser.mjs --live",
    "check": "node scripts/check.mjs",
    "doctor": "node scripts/doctor.mjs",
    "android": "npm run android --workspace @lan-tube/android",
    "metro": "npm run start --workspace @lan-tube/android",
    "android:bundle": "npm run bundle --workspace @lan-tube/android",
    "android:setup": "node scripts/setup-android.mjs",
    "android:release": "node scripts/build-android.mjs"
  }
}
